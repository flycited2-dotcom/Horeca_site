APP_NAME="Гастроснаб"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_TIMEZONE=Europe/Moscow

APP_LOCALE=ru
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ru_RU

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# MariaDB 11.8 (или MySQL 8.4: DB_CONNECTION=mysql). SQLite в проекте запрещён.
DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=horeca
DB_USERNAME=horeca
DB_PASSWORD=
DB_COLLATION=utf8mb4_unicode_ci

# Локально — database; на сервере — redis (ТЗ §17.4).
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Фото товаров и счета (ТЗ §17): локально — public и local, на сервере — s3 и s3-private.
MEDIA_DISK=public
INVOICES_DISK=local
QUEUE_CONNECTION=database
# Очередь импорта и фото поставщика: локально — database-imports, на сервере — redis-imports (ТЗ §17.4).
IMPORTS_QUEUE_CONNECTION=database-imports
IMPORTS_QUEUE_RETRY_AFTER=3700

CACHE_STORE=database
# CACHE_PREFIX=

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Хранилище S3 Спринтхоста: бакет общий для сайтов сервера, у магазина своя папка.
# Ключи доступа вписываются только в .env сервера.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=spb
AWS_BUCKET=s3-968732
AWS_ROOT=gastrosnab
AWS_ENDPOINT=https://s3.spb.sprinthost.ru
AWS_URL=https://s3.spb.sprinthost.ru/s3-968732
AWS_USE_PATH_STYLE_ENDPOINT=true
# Бакет s3-968732 провайдер отдаёт всем: он годится для фото, но не для счетов.
# Появится приватный бакет — вписать его сюда и поставить INVOICES_DISK=s3-private.
AWS_PRIVATE_BUCKET=
AWS_PRIVATE_ROOT=

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="shop@example.ru"
MAIL_FROM_NAME="${APP_NAME}"

# Бот и группа менеджеров (ТЗ §13). Пока не заполнены — уведомления идут в журнал.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

VITE_APP_NAME="${APP_NAME}"
